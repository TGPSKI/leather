# eval run output (adjudication pass)
predictions.adjudicated.jsonl
predictions-*.jsonl

# derived analyze caches for positional-control arms
.caches/

# Per-cell run archives are COMMITTED as of the 2026-07-29 publication pass:
# they are the evidence behind every published figure (manifests, sigeval
# reports, predictions, logprobs, evidence logs), write-once, and small
# (~9 MB total). A skeptic can re-run table.py / paired-verdicts.py /
# verify-run.sh and re-score predictions against gold with no GPU. Battery
# scratch below stays ignored.

# battery scratch (per-cell logs; archives live in results/runs/)
**/eval/.battery/
